.class public final Lcom/ifengyu/intercom/OfflineLogin;
.super Ljava/lang/Object;
.source "OfflineLogin.java"


# Mi-Walkie-Talkie-Plus: the ifengyu / Xiaomi account servers have been shut
# down, so it is no longer possible to sign in. Everything needed to talk to the
# radio (scan, connect, activate, read and write channels) happens locally over
# Bluetooth LE and only uses the account as a "logged in" gate. This helper
# stores a local placeholder account so the app skips the login screen.


# direct methods
.method private constructor <init>()V
    .locals 0

    invoke-direct {p0}, Ljava/lang/Object;-><init>()V

    return-void
.end method

# Returns true if a placeholder account had to be created, false if one
# (real or placeholder) already existed.
